{
  plugins: {
    // configuration of "storage_manager" plugin:
    storage_manager: {
      volumes: {
        // DuckDB volume - 只管理数据库连接
        duckdb: {
          // DuckDB database file path (optional, defaults to :memory:)
          db_path: "./duckdb.db"
        }
      },
      storages: {
        // Suricata flow events - 使用JSON Schema文件自动生成表结构
        flow: {
          key_expr: "zenoh/duckdb/evelog.flow",     // 支持通配符，如 evelog.*
          volume: {
            id: "duckdb",
            db_schema: "evelog",                       // DuckDB数据库schema（命名空间）- 必需
            db_table: "flow",                          // DuckDB表名 - 必需
            db_table_desc: "etc/flow_schema.json"          // JSON Schema文件路径 - 可选
          }
        },

        // Application logs - 使用默认存储策略
        app: {
          key_expr: "zenoh/duckdb/app.*",           // 支持通配符
          volume: {
            id: "duckdb",
            db_schema: "app",                          // DuckDB数据库schema（命名空间）- 必需
            db_table: "logs"                           // DuckDB表名 - 必需
            // 不配置column则使用默认存储策略
          }
        }
      }
    }
  }
}