{
  plugins: {
    // configuration of "storage_manager" plugin:
    storage_manager: {
      volumes: {
        // DuckDB volume - manages database connections
        duckdb: {
          // DuckDB database file path (optional, defaults to :memory:)
          db_path: "./duckdb.db",
          // Initialization SQL script file path (optional)
          init_sql: "etc/init.sql"
        }
      },
      storages: {
        // Suricata flow events - auto-generate table structure from JSON Schema file
        flow: {
          key_expr: "zenoh/duckdb/evelog.flow",        // supports wildcards like evelog.*
          volume: {
            id: "duckdb",
            db_schema: "evelog",                       // DuckDB database schema (namespace) - required
            db_table: "flow",                          // DuckDB table name - required
            db_table_desc: "etc/flow_schema.json"      // JSON Schema file path - optional
          }
        },

        // Application logs - use default storage strategy
        app: {
          key_expr: "zenoh/duckdb/app.*",              // supports wildcards
          volume: {
            id: "duckdb",
            db_schema: "app",                          // DuckDB database schema (namespace) - required
            db_table: "logs"                           // DuckDB table name - required
          }
        }
      }
    }
  }
}
